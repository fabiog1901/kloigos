{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabiog1901.github.io/kloigos/validation/report.schema.json",
  "title": "Kloigos real-host validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "summary", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "target", "started_at", "finished_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "skipped", "errors"],
      "properties": {
        "status": { "enum": ["passed", "failed", "error"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped", "error"] },
        "summary": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "summary"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed", "skipped", "error"] },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
