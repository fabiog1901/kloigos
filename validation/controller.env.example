# Copy these settings into your shell or an untracked local environment file.
# The inventory must contain only explicitly designated remote Kloigos test hosts.
KLOIGOS_VALIDATION_INVENTORY=/absolute/path/to/kloigos-validation.ini
# Optional profile name; destructive profiles require their phase-specific arguments.
KLOIGOS_VALIDATION_PROFILE=smoke
# Optional local directory for fetched remote JSON reports.
KLOIGOS_VALIDATION_REPORT_DIR=/absolute/path/to/kloigos-validation-reports
# Required by fixture-provisioning phases; keep real values outside the repository.
KLOIGOS_VALIDATION_FIXTURE_MANIFEST=/absolute/path/to/kloigos-validation-fixtures.yaml
