#!/usr/bin/env bash
# Local controller entry point for manually requested Kloigos validation.
set -euo pipefail

if [[ "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: make validate

Run from the Ubuntu development machine. Set KLOIGOS_VALIDATION_INVENTORY to
an Ansible inventory containing explicitly designated remote Kloigos test hosts.
This controller does not accept localhost inventories and never starts validation
automatically. Remote orchestration is added in the next validation phase.
EOF
  exit 0
fi

inventory="${KLOIGOS_VALIDATION_INVENTORY:-}"
if [[ -z "$inventory" ]]; then
  echo "KLOIGOS_VALIDATION_INVENTORY is required; see validation/controller.env.example." >&2
  exit 2
fi
if [[ ! -f "$inventory" ]]; then
  echo "Validation inventory does not exist: $inventory" >&2
  exit 2
fi
if grep -Eq '(^|[[:space:]])(localhost|127\.0\.0\.1|::1)([[:space:]]|$)' "$inventory"; then
  echo "Validation inventory must name remote Kloigos test hosts, not localhost." >&2
  exit 2
fi

echo "Kloigos validation controller"
echo "Inventory: $inventory"
if ! command -v ansible-playbook >/dev/null 2>&1; then
  echo "ansible-playbook is required on the validation controller." >&2
  exit 2
fi

profile="${KLOIGOS_VALIDATION_PROFILE:-smoke}"
report_dir="${KLOIGOS_VALIDATION_REPORT_DIR:-$(pwd)/validation/reports/controller}"
mkdir -p "$report_dir"
run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
fixture_vars=""
if [[ -n "${KLOIGOS_VALIDATION_FIXTURE_MANIFEST:-}" || -n "${KLOIGOS_VALIDATION_FIXTURE_ALLOCATION:-}" ]]; then
  fixture_vars="$(KLOIGOS_VALIDATION_FIXTURE_MANIFEST="${KLOIGOS_VALIDATION_FIXTURE_MANIFEST:-}" KLOIGOS_VALIDATION_FIXTURE_ALLOCATION="${KLOIGOS_VALIDATION_FIXTURE_ALLOCATION:-}" poetry run python scripts/validation-fixture-context)"
fi
if [[ "$profile" == "cpu-cgroup-enforcement" && -z "$fixture_vars" ]]; then
  echo "cpu-cgroup-enforcement requires a selected fixture manifest allocation." >&2
  exit 2
fi
if [[ "$profile" == "cpu-cgroup-enforcement" && "${KLOIGOS_VALIDATION_CONFIRM:-}" != "RUN_VALIDATION" ]]; then
  echo "cpu-cgroup-enforcement requires KLOIGOS_VALIDATION_CONFIRM=RUN_VALIDATION." >&2
  exit 2
fi
echo "Profile: $profile"
echo "Run ID: $run_id"
echo "Controller reports: $report_dir"
extra_vars=(--extra-vars "validation_profile=$profile validation_controller_report_dir=$report_dir validation_run_id=$run_id")
if [[ -n "$fixture_vars" ]]; then
  extra_vars+=(--extra-vars "$fixture_vars")
fi
ansible-playbook -i "$inventory" validation/ansible/RUN_VALIDATION.yaml "${extra_vars[@]}"
