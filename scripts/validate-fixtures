#!/usr/bin/env python3
"""Provision or clean the explicit Kloigos demo validation fixtures."""
from __future__ import annotations
import json, sys, time
from pathlib import Path
from urllib.request import Request, urlopen
import yaml

manifest = Path(__import__('os').environ.get('KLOIGOS_VALIDATION_FIXTURE_MANIFEST', ''))
if not manifest.is_file(): raise SystemExit('KLOIGOS_VALIDATION_FIXTURE_MANIFEST must name a manifest file.')
action = sys.argv[1] if len(sys.argv) == 2 else ''
if action not in {'setup', 'cleanup'}: raise SystemExit('Usage: scripts/validate-fixtures {setup|cleanup}')
data = yaml.safe_load(manifest.read_text()); base = data['control_plane']['url'].rstrip('/')
def call(method, path, body=None):
    raw = json.dumps(body).encode() if body is not None else None
    req = Request(base + path, data=raw, method=method, headers={'Content-Type':'application/json'})
    with urlopen(req, timeout=30) as response: return json.loads(response.read() or b'null')
def wait(job):
    for _ in range(120):
        state = call('GET', f'/jobs/{job["job_id"]}')
        if state.get('status') in {'successful', 'failed', 'cancelled'}:
            if state['status'] != 'successful': raise RuntimeError(f'Job {job["job_id"]} ended {state["status"]}.')
            return
        time.sleep(2)
    raise RuntimeError(f'Job {job["job_id"]} timed out.')
if action == 'setup':
    addresses=[item['ip_address'] for item in data['allocations']]
    call('POST','/admin/ip_pool/',{'ip_addresses':addresses})
    for item in data['allocations']:
        payload={key:item[key] for key in ('allocation_id','login_user','cpu_count','region','zone','tags') if key in item}
        payload['ssh_public_key']=item['ssh_public_key']
        wait(call('POST','/allocations/',payload))
else:
    for item in reversed(data['allocations']): wait(call('DELETE',f'/allocations/{item["allocation_id"]}'))
    for item in data['allocations']: call('DELETE',f'/admin/ip_pool/{item["ip_address"]}')
print(f'Fixture {action} completed.')
